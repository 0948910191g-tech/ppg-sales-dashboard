function PPG_CANON_selectDaily_(rows,batchRows){var accepted={};(batchRows||[]).forEach(function(b){if(String(b.Batch_Status||'').toUpperCase()==='ACCEPTED'&&String(b.Final_Status||'').toUpperCase()!=='REJECTED')accepted[b.Batch_ID]=1;});var best={};(rows||[]).forEach(function(r){if(r.Canonical_Eligible!==true||!accepted[r.Batch_ID])return;var p=PPG_CORE_normalizePlatform_(r.Platform),d=String(r.Metric_Date||'');if(!p||!PPG_CORE_validateIsoDate_(d))return;var k=[r.Workspace_ID,p,d,r.Metric_Scope].join('|'),n={};Object.keys(r).forEach(function(x){n[x]=r[x];});n.Platform=p;n.Metric_Date=d;var score=[String(n.Imported_At||''),String(n.Period_End||''),String(n.Batch_ID||''),JSON.stringify(n)].join('|');if(!best[k]||score>best[k]._s)best[k]={_s:score,row:n};});return Object.keys(best).sort().map(function(k){return best[k].row;});}
