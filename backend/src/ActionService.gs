function PPG_ACTION_create_(repo,user,input,now){var t=now||new Date().toISOString(),s=String(input&&input.status||'').toUpperCase();if(!input||!String(input.title||'').trim()||!String(input.owner||'').trim()||['TODO','IN_PROGRESS','DONE','CANCELLED'].indexOf(s)<0)throw new Error('INVALID_ACTION');var id='action-'+new Date(t).getTime()+'-'+repo.read('Action_Tasks').length;var row={Workspace_ID:user.workspaceId,Action_ID:id,Title:String(input.title).trim(),Description:input.description||'',Owner_User_ID:String(input.owner).trim(),Status:s,Priority:input.priority||'',Due_Date:input.dueDate||'',Created_At:t,Updated_At:t};repo.append('Action_Tasks',[row]);repo.append('Action_History',[{Workspace_ID:user.workspaceId,Action_History_ID:id+'-created',Action_ID:id,Event_Type:'CREATED',Previous_Value:'',New_Value:s,Actor_User_ID:user.userId,Created_At:t}]);return row;}
function PPG_ACTION_update_(repo,user,input,now){var a=repo.find('Action_Tasks',{Action_ID:input.actionId,Workspace_ID:user.workspaceId})[0];if(!a)throw new Error('ACTION_NOT_FOUND');var t=now||new Date().toISOString(),c={Updated_At:t};if(input.title)c.Title=String(input.title).trim();if(input.owner)c.Owner_User_ID=String(input.owner).trim();repo.update('Action_Tasks',{Action_ID:a.Action_ID,Workspace_ID:user.workspaceId},c);repo.append('Action_History',[{Workspace_ID:user.workspaceId,Action_History_ID:a.Action_ID+'-'+new Date(t).getTime(),Action_ID:a.Action_ID,Event_Type:'UPDATED',Previous_Value:'',New_Value:'',Actor_User_ID:user.userId,Created_At:t}]);return repo.find('Action_Tasks',{Action_ID:a.Action_ID})[0];}
function PPG_ACTION_changeStatus_(repo,user,input,now){var a=repo.find('Action_Tasks',{Action_ID:input.actionId,Workspace_ID:user.workspaceId})[0];if(!a)throw new Error('ACTION_NOT_FOUND');var next=String(input.status||'').toUpperCase(),allowed={TODO:['IN_PROGRESS','CANCELLED'],IN_PROGRESS:['DONE','CANCELLED'],DONE:[],CANCELLED:[]};if(!allowed[a.Status]||allowed[a.Status].indexOf(next)<0)throw new Error('INVALID_STATUS_TRANSITION');var t=now||new Date().toISOString();repo.update('Action_Tasks',{Action_ID:a.Action_ID,Workspace_ID:user.workspaceId},{Status:next,Updated_At:t});repo.append('Action_History',[{Workspace_ID:user.workspaceId,Action_History_ID:a.Action_ID+'-'+new Date(t).getTime(),Action_ID:a.Action_ID,Event_Type:'STATUS_CHANGED',Previous_Value:a.Status,New_Value:next,Actor_User_ID:user.userId,Created_At:t}]);return repo.find('Action_Tasks',{Action_ID:a.Action_ID})[0];}
