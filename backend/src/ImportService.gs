function PPG_IMPORT_registerUpload_(deps,user,files,now){
  if(!user||!user.permissions||user.permissions.indexOf('uploads.create')<0)throw new Error('FORBIDDEN');
  var t=now||new Date().toISOString(),out=[];(files||[]).forEach(function(f){var ext=String(f.name||'').toLowerCase().split('.').pop();if(['csv','xlsx','xls','gsheet'].indexOf(ext)<0)throw new Error('UNSUPPORTED_EXTENSION');if((f.size||0)>50*1024*1024)throw new Error('FILE_TOO_LARGE');var hash=deps.hashContent?deps.hashContent(f.content):f.hash;if(!hash)throw new Error('HASH_REQUIRED');var dup=deps.repo.find('DB_Import_Files',{Source_File_Hash:hash}).length>0,id=f.id||('file-'+new Date().getTime()+'-'+out.length),bid='batch-'+new Date().getTime()+'-'+out.length;if(deps.storeFile)deps.storeFile(f,'Inbox');deps.repo.append('DB_Import_Batches',[{Workspace_ID:user.workspaceId,Batch_ID:bid,Platform:f.platform||'',Period_Start:f.periodStart||null,Period_End:f.periodEnd||null,Imported_At:t,Batch_Status:dup?'DUPLICATE':'QUEUED',Final_Status:null,Created_At:t,Updated_At:t}]);deps.repo.append('DB_Import_Files',[{Workspace_ID:user.workspaceId,Batch_ID:bid,Source_File_ID:id,Source_File_Name:f.name,Source_File_Hash:hash,Source_File_Modified_At:f.modifiedAt||null,Source_File_Imported_At:t,Created_At:t}]);out.push({batchId:bid,status:dup?'DUPLICATE':'QUEUED'});});return out;
}
function PPG_IMPORT_processBatchCore_(deps,batchId){var locked=deps.lock&&deps.lock.tryLock?deps.lock.tryLock():true;if(!locked)throw new Error('LOCK_REJECTED');var repo=deps.repo,processed=[];try{var b=repo.find('DB_Import_Batches',{Batch_ID:batchId})[0];if(!b)throw new Error('BATCH_NOT_FOUND');if(['ACCEPTED','REJECTED','DUPLICATE'].indexOf(b.Batch_Status)>=0)return b;var files=repo.find('DB_Import_Files',{Batch_ID:batchId}),all=[];files.forEach(function(f){if(deps.moveFile)deps.moveFile(f.Source_File_ID,b.Batch_Status==='FAILED'?'Processing':'Inbox','Processing');processed.push(f);try{var raw=deps.readFile(f.Source_File_ID),matrix=/\.xlsx?$/i.test(f.Source_File_Name)&&deps.convertXlsx?deps.convertXlsx(raw):raw,p=PPG_PARSE_matrix_(f.Source_File_Name,matrix,{Workspace_ID:b.Workspace_ID,Batch_ID:batchId,Source_File_ID:f.Source_File_ID,Platform:b.Platform,Imported_At:b.Imported_At});if(!PPG_CORE_validatePeriod_(String(p.period.start),String(p.period.end)))throw new Error('INVALID_PERIOD');if(p.route.targetSheet==='DB_Canonical_Daily')all=all.concat(p.rows);else if(p.route.targetSheet==='DB_Import_Batches'){repo.update('DB_Import_Files',{Source_File_ID:f.Source_File_ID},{Raw_Record:JSON.stringify(p.rows)});}else if(p.route.targetSheet&&p.rows.length&&!repo.find(p.route.targetSheet,{Source_File_ID:f.Source_File_ID}).length)repo.append(p.route.targetSheet,p.rows);}catch(e){e.sourceFileId=f.Source_File_ID;throw e;}});if(all.length&&!repo.find('DB_Canonical_Daily',{Batch_ID:batchId}).length){var selected=PPG_CANON_selectDaily_(all,[{Batch_ID:batchId,Batch_Status:'ACCEPTED',Final_Status:'ACCEPTED'}]);repo.append('DB_Canonical_Daily',selected);}repo.update('DB_Import_Batches',{Batch_ID:batchId},{Batch_Status:'ACCEPTED',Final_Status:'ACCEPTED',Updated_At:new Date().toISOString()});processed.forEach(function(f){if(deps.moveFile)deps.moveFile(f.Source_File_ID,'Processing','Archive');});return repo.find('DB_Import_Batches',{Batch_ID:batchId})[0];}catch(e){var b2=repo.find('DB_Import_Batches',{Batch_ID:batchId})[0],code=e.code||e.message,perm=['HEADER_NOT_FOUND','UNSUPPORTED_REPORT','INVALID_PERIOD'].indexOf(code)>=0;repo.append('DB_Import_Errors',[{Workspace_ID:b2&&b2.Workspace_ID,Batch_ID:batchId,Source_File_ID:e.sourceFileId||null,Error_Code:code,Error_Message:String(e.message||e),Created_At:new Date().toISOString()}]);repo.update('DB_Import_Batches',{Batch_ID:batchId},{Batch_Status:perm?'REJECTED':'FAILED',Updated_At:new Date().toISOString()});if(perm)processed.forEach(function(f){if(deps.moveFile)deps.moveFile(f.Source_File_ID,'Processing','Rejected');});return repo.find('DB_Import_Batches',{Batch_ID:batchId})[0];}finally{if(deps.lock&&deps.lock.releaseLock)deps.lock.releaseLock();}}
function PPG_IMPORT_getStatus_(repo,batchId){var b=repo.find('DB_Import_Batches',{Batch_ID:batchId}),e=repo.find('DB_Import_Errors',{Batch_ID:batchId});if(!b.length)return PPG_API_error_('BATCH_NOT_FOUND','Batch not found');b=b[0];var accepted=b.Batch_Status==='ACCEPTED',rows=accepted?repo.find('DB_Canonical_Daily',{Batch_ID:batchId}):[],files=repo.find('DB_Import_Files',{Batch_ID:batchId});files.forEach(function(f){f.errors=e.filter(function(x){return x.Source_File_ID===f.Source_File_ID;});});return PPG_API_ok_({status:b.Batch_Status,files:files,errors:e,rowCount:rows.length},{workspaceId:b.Workspace_ID,acceptedBatchIds:accepted?[batchId]:[],dataThrough:rows.length?rows.map(function(r){return r.Metric_Date;}).sort().pop():null});}
