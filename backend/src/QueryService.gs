function PPG_QUERY_dashboard_(rows,batches,q){q=q||{};var p=q.platform?PPG_CORE_normalizePlatform_(q.platform):null;if(q.platform&&!p)PPG_PARSE_fail_('INVALID_PLATFORM');if(!PPG_CORE_validateIsoDate_(q.start)||!PPG_CORE_validateIsoDate_(q.end)||q.start>q.end)PPG_PARSE_fail_('INVALID_PERIOD');var all=PPG_CANON_selectDaily_(rows,batches),f=function(a,s,e){return a.filter(function(r){return r.Metric_Date>=s&&r.Metric_Date<=e&&(!p||r.Platform===p);});},sum=function(a){var s={GMV:null,Orders:null,Units:null},v={GMV:false,Orders:false,Units:false};a.forEach(function(r){['GMV','Orders','Units'].forEach(function(k){if(typeof r[k]==='number'){s[k]=(s[k]===null?0:s[k])+r[k];v[k]=true;}});});return{s:s,v:v};},cur=f(all,q.start,q.end),c=sum(cur),split={};cur.forEach(function(r){if(r.GMV!=null)split[r.Platform]=(split[r.Platform]||0)+r.GMV;});var ids=[];cur.forEach(function(r){if(ids.indexOf(r.Batch_ID)<0)ids.push(r.Batch_ID);});ids.sort();var trend={};cur.forEach(function(r){if(r.GMV!=null)trend[r.Metric_Date]=(trend[r.Metric_Date]||0)+r.GMV;else trend[r.Metric_Date]=null;});var days=Math.round((new Date(q.end)-new Date(q.start))/86400000)+1,st=new Date(q.start+'T00:00:00Z'),en=new Date(q.start+'T00:00:00Z');st.setUTCDate(st.getUTCDate()-days);en.setUTCDate(en.getUTCDate()-1);var prior=f(all,st.toISOString().slice(0,10),en.toISOString().slice(0,10)),pr=sum(prior);return{summary:c.s,summaryAvailability:c.v,platformSplit:split,dailyTrend:Object.keys(trend).sort().map(function(d){return{date:d,GMV:trend[d]};}),dataThrough:cur.length?cur.map(function(r){return r.Metric_Date;}).sort().pop():null,acceptedBatchIds:ids,previous:{available:prior.length>0,summary:pr.s,platformSplit:{}}};}
function PPG_QUERY_periodAvailability_(m,s,e,ss,se){return m==='month'&&s===ss&&e===se?{available:true}:{available:false,reason:'SOURCE_SCOPE_PERIOD_ONLY'};}
